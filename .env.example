# ============================================================================
# Facebook Posts Scraper — environment template
# ============================================================================
# Copy this file to `.env` and adjust values for your environment:
#
#     cp .env.example .env
#
# There are NO real secrets in this file — placeholders only. The values
# below are also the built-in defaults, so the app runs correctly even
# without a .env (docker compose uses them via ${VAR:-default}).
#
# Backend env vars are read by pydantic-settings (backend/core/config.py and
# any .env file in the working directory). Scraper env vars are read directly
# from the environment by backend/scraper/fetcher.py. The frontend env var is
# Next.js build-time only.
# ============================================================================

# ---------------------------------------------------------------------------
# Application (optional overrides)
# ---------------------------------------------------------------------------
# DEBUG=true enables verbose logging.
DEBUG=false
# APP_NAME=Facebook Posts Scraper API
# VERSION=1.0.0
# API_PREFIX=/api

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# SQLite (default). The file is created automatically under data/.
DATABASE_URL=sqlite:///./data/facebook_scraper.db

# PostgreSQL alternative (uncomment; requires the psycopg driver listed in
# backend/requirements.txt — uncomment the pinned psycopg[binary] line there,
# or use the optional `db` service in docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://fb_scraper:change-me@localhost:5432/fb_scraper
# The Postgres host is the container service name (`db`) when running the
# compose `db` service: postgresql+psycopg://fb_scraper:change-me@db:5432/fb_scraper

DATA_DIR=./data
# Where export files land: <EXPORT_BASE_DIR>/<job_id>/facebook_posts.{json,csv,xlsx}
EXPORT_BASE_DIR=./data/exports

# ---------------------------------------------------------------------------
# Worker / job manager
# ---------------------------------------------------------------------------
# Number of background scrape worker threads (parallel sources).
WORKER_THREADS=4
# Maximum URLs accepted per scrape request.
MAX_URLS_PER_JOB=100
# Seconds DELETE /api/jobs/{id} waits for an in-flight worker before deleting rows.
CANCEL_WAIT_SECONDS=5.0
# Per-source default post cap when the request does not specify max_posts.
DEFAULT_MAX_POSTS=
# Default post type filter: text | image | video | link | all
DEFAULT_POST_TYPE=all

# ---------------------------------------------------------------------------
# HTTP / CORS
# ---------------------------------------------------------------------------
# JSON array of browser origins allowed to call the API directly.
# The frontend dashboard (http://localhost:3000) is allowed by default.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ---------------------------------------------------------------------------
# Pagination
# ---------------------------------------------------------------------------
PAGE_SIZE_DEFAULT=50
PAGE_SIZE_MAX=200

# ---------------------------------------------------------------------------
# Scraper — compliance knobs (lower = faster but less polite; see COMPLIANCE.md)
# ---------------------------------------------------------------------------
# Minimum delay between requests to facebook.com (seconds, floor 0.1).
# Default 2.5 s. Do NOT lower this in production use.
SCRAPER_DELAY_SECONDS=2.5
# Hard per-request timeout (seconds).
SCRAPER_TIMEOUT_SECONDS=20
# Max retries with exponential backoff on 429/5xx/transport/timeout (honors Retry-After).
SCRAPER_MAX_RETRIES=3
# 1 = enforce robots.txt, 0 = skip robots.txt checks (tests only; keep 1 in production).
SCRAPER_ROBOTS=1

# ---------------------------------------------------------------------------
# Frontend (Next.js — BUILD-TIME ONLY)
# ---------------------------------------------------------------------------
# Base URL of the backend API as seen FROM THE BROWSER. Inlined into the JS
# bundle during `next build` / `docker build`; changing it requires a rebuild.
# For local development: http://localhost:8000
# For a remote deployment: https://api.yourdomain.com
# NOTE: do not use `http://backend:8000` unless the browser can resolve it.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public origin of THIS frontend as seen by crawlers/search engines. Used for
# sitemap.xml, robots.txt and Open Graph canonical URLs (build-time only).
# Example: https://facebook-posts.yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# PostgreSQL service (docker-compose.yml `db` service) — credentials,
# placeholders only, used by the optional Postgres path:
# ---------------------------------------------------------------------------
# POSTGRES_USER=fb_scraper
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=fb_scraper
